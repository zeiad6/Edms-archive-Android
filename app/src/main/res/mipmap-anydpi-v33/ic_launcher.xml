<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ variant. <monochrome> lets the launcher tint the icon with the
  user's wallpaper theme, which is why this is a separate -v33 folder rather
  than an extra element in the -v26 one.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
