<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replacement for android:allowBackup.

  Nothing here is worth transferring, and the credentials blob is AES-GCM
  ciphertext whose key never leaves the Android Keystore, so a restored copy
  would be undecryptable anyway — it is excluded rather than left to rot.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="credentials.xml" />
        <exclude domain="sharedpref" path="link.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="credentials.xml" />
        <exclude domain="sharedpref" path="link.xml" />
    </device-transfer>
</data-extraction-rules>
