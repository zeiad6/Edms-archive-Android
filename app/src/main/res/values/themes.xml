<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#4F46E5</color>
    <color name="brand_dark">#1E1B4B</color>
    <!-- Light scheme. The Compose theme in ui/Appearance.kt is the source of
         truth for in-app colours; these are only the pre-Compose window colours
         (splash / window background), which must match or the app flashes. -->
    <style name="Theme.Edms" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">#F4F5F7</item>
    </style>
    <style name="Theme.Edms.NoActionBar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:windowBackground">#F4F5F7</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
