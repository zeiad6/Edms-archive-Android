<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark scheme. `ui/Appearance.kt` also decides the palette from the in-app
  SYSTEM/LIGHT/DARK setting, which can differ from the system one — these
  resources only cover the window itself, so a device in dark mode never gets a
  white flash before Compose draws.
-->
<resources>
    <style name="Theme.Edms" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#A5B4FC</item>
        <item name="android:colorPrimaryDark">#0A0B12</item>
        <item name="android:colorAccent">#A5B4FC</item>
        <item name="android:windowBackground">#0A0B12</item>
    </style>
    <style name="Theme.Edms.NoActionBar" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#A5B4FC</item>
        <item name="android:windowBackground">#0A0B12</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
